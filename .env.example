# Comma-separated LLM API keys pool (at least 2 keys; key_1, key_2, ...)
LLM_API_KEYS=your_gemini_api_key_1,your_gemini_api_key_2

# SQLite database URL (in Docker: sqlite:////data/app.db; local: sqlite:///./data/app.db)
DATABASE_URL=sqlite:////data/app.db

# Comma-separated CORS allowed origins
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Enables X-Simulate-Failure header hook (must be true in deployed backend)
ENABLE_FAILURE_SIMULATION=true

# LiteLLM model identifier
LLM_MODEL=gemini/gemini-2.0-flash

# Default session system prompt
DEFAULT_SYSTEM_PROMPT=You are a helpful and concise AI assistant.

# LLM call timeout in seconds
LLM_TIMEOUT=30

# LiteLLM cache type (local or disk)
CACHE_TYPE=local

# Server port
PORT=8000

# Frontend API URL (for Vite build)
VITE_API_URL=http://localhost:8000
